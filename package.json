{
  "name": "summer-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run check:compatibility && npm run check:reference && npm run check:skills && npm run check:language && npm run check:capabilities && npm run check:policy-fixtures && npm run check:routes && node scripts/check-docs.mjs",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "check:policy-fixtures": "node scripts/check-policy-fixtures.mjs",
    "check:compatibility": "node scripts/sync-engine-compatibility.mjs --check",
    "check:external-links": "node scripts/check-external-links.mjs",
    "check:language": "node scripts/check-language.mjs",
    "check:reference": "node scripts/reference/generate.mjs --check",
    "check:routes": "node scripts/check-routes.mjs",
    "check:skills": "node scripts/skills/generate.mjs --check",
    "generate:compatibility": "node scripts/sync-engine-compatibility.mjs",
    "generate:reference": "node scripts/reference/generate.mjs",
    "generate:routes": "node scripts/check-routes.mjs --write",
    "generate:skills": "node scripts/skills/generate.mjs",
    "sync:reference": "node scripts/reference/sync.mjs",
    "sync:skills": "node scripts/skills/sync.mjs"
  }
}
