{
  "registry": "summer-router",
  "version": 1,
  "docs_base_url": "https://docs.summerengine.com",
  "kinds": [
    {
      "id": "character.reply",
      "title": "Character reply",
      "status": "preview",
      "stream": false,
      "billing_unit": "token",
      "limit_keys": [
        "player_day",
        "game_day",
        "game_month",
        "account_month",
        "environment_day",
        "character_player_day",
        "character_game_day"
      ],
      "player_route": "POST /v1/games/{gameId}/router/character.reply",
      "host_op": "request_router_reply",
      "gdscript": "Summer.client.router.reply(character: String, text: String, options: Dictionary = {}) -> SummerRouterResult",
      "mcp_tool": "summer_router_character_reply",
      "cli": "summer router test <character> --say <text>",
      "studio_form": "game-router-characters",
      "docs_slug": "router/character-reply",
      "inputs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "character"
        ],
        "anyOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "tool_results"
            ]
          }
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "character": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "conversation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "variables": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z_][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            }
          },
          "context": {
            "type": "string",
            "maxLength": 4000
          },
          "overrides": {
            "type": "object",
            "maxProperties": 16
          },
          "tool_results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "call_id",
                "output"
              ],
              "properties": {
                "call_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "output": {}
              }
            }
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "request_id",
          "exchange_id",
          "character",
          "text",
          "tool_calls",
          "usage"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "exchange_id": {
            "type": "string",
            "pattern": "^rex_[0-9a-f]{32}$"
          },
          "character": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "call_id",
                "name",
                "args",
                "runs_on"
              ],
              "properties": {
                "call_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "args": {
                  "type": "object"
                },
                "runs_on": {
                  "enum": [
                    "client",
                    "authority"
                  ]
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "id": "character.voice",
      "title": "Character voice session",
      "status": "planned",
      "stream": true,
      "billing_unit": "second",
      "limit_keys": [
        "player_day",
        "game_day",
        "game_month",
        "account_month",
        "environment_day",
        "character_player_day",
        "character_game_day"
      ],
      "player_route": "POST /v1/games/{gameId}/router/character.voice",
      "host_op": "",
      "gdscript": "Summer.client.router.talk(character: String, options: Dictionary = {\"mode\": \"voice\"}) -> SummerRouterSession",
      "mcp_tool": "",
      "cli": "",
      "studio_form": "game-router-characters",
      "docs_slug": "router/character-voice",
      "inputs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "character"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "character": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "variables": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[a-z_][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            }
          },
          "context": {
            "type": "string",
            "maxLength": 4000
          },
          "overrides": {
            "type": "object",
            "maxProperties": 16
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "session_id",
          "max_seconds"
        ],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "max_seconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "id": "speech",
      "title": "Speech",
      "status": "preview",
      "stream": false,
      "billing_unit": "character",
      "limit_keys": [
        "player_day",
        "game_day",
        "game_month",
        "account_month",
        "environment_day",
        "character_player_day",
        "character_game_day"
      ],
      "player_route": "POST /v1/games/{gameId}/router/speech",
      "host_op": "request_router_speech",
      "gdscript": "Summer.client.router.speak(text: String, options: Dictionary = {\"character\": \"\"}) -> SummerRouterResult",
      "mcp_tool": "summer_router_speech",
      "cli": "",
      "studio_form": "game-router-playground",
      "docs_slug": "router/speech",
      "inputs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id"
        ],
        "oneOf": [
          {
            "required": [
              "text",
              "character"
            ]
          },
          {
            "required": [
              "exchange_id"
            ]
          }
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "character": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "exchange_id": {
            "type": "string",
            "pattern": "^rex_[0-9a-f]{32}$"
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "request_id",
          "audio",
          "mime_type",
          "usage"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "audio": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "mime_type": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "properties": {
              "characters": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "id": "transcribe",
      "title": "Transcribe",
      "status": "planned",
      "stream": false,
      "billing_unit": "second",
      "limit_keys": [
        "player_day",
        "game_day",
        "game_month",
        "account_month",
        "environment_day"
      ],
      "player_route": "POST /v1/games/{gameId}/router/transcribe",
      "host_op": "request_router_transcription",
      "gdscript": "Summer.client.router.transcribe(clip: AudioStream, options: Dictionary = {}) -> SummerRouterResult",
      "mcp_tool": "summer_router_transcribe",
      "cli": "",
      "studio_form": "game-router-playground",
      "docs_slug": "router/transcribe",
      "inputs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "audio",
          "mime_type"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "audio": {
            "type": "string",
            "contentEncoding": "base64",
            "minLength": 4,
            "maxLength": 1398104
          },
          "mime_type": {
            "enum": [
              "audio/wav",
              "audio/ogg",
              "audio/mpeg",
              "audio/webm",
              "audio/mp4"
            ]
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "request_id",
          "text",
          "usage"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "properties": {
              "audio_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "id": "image",
      "title": "Image",
      "status": "preview",
      "stream": false,
      "billing_unit": "image",
      "limit_keys": [
        "player_day",
        "game_day",
        "game_month",
        "account_month",
        "environment_day"
      ],
      "player_route": "POST /v1/games/{gameId}/router/image",
      "host_op": "request_router_image",
      "gdscript": "Summer.client.router.generate(\"image\", {\"prompt\": prompt, \"size\": \"1024x1024\"}) -> SummerRouterResult",
      "mcp_tool": "summer_router_image",
      "cli": "",
      "studio_form": "game-router-playground",
      "docs_slug": "router/image",
      "inputs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "prompt"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,64}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "size": {
            "enum": [
              "512x512",
              "1024x1024",
              "1024x1536",
              "1536x1024"
            ]
          },
          "reference_image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "data",
              "mime_type"
            ],
            "properties": {
              "data": {
                "type": "string",
                "contentEncoding": "base64",
                "minLength": 4,
                "maxLength": 5592408
              },
              "mime_type": {
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              }
            }
          }
        }
      },
      "outputs": {
        "type": "object",
        "required": [
          "request_id",
          "image",
          "mime_type",
          "usage"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "mime_type": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "properties": {
              "images": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  ],
  "limit_keys": [
    {
      "id": "player_day",
      "title": "Per player per day",
      "window": "day",
      "setting": "player_day_micro_usd"
    },
    {
      "id": "game_day",
      "title": "Per game per day",
      "window": "day",
      "setting": "game_day_micro_usd"
    },
    {
      "id": "game_month",
      "title": "Per game per month",
      "window": "month",
      "setting": "game_month_micro_usd"
    },
    {
      "id": "account_month",
      "title": "Per account per month",
      "window": "month",
      "setting": "account_month_micro_usd"
    },
    {
      "id": "environment_day",
      "title": "Environment ceiling per day",
      "window": "day",
      "setting": ""
    },
    {
      "id": "character_player_day",
      "title": "Per character per player per day",
      "window": "day",
      "setting": "limits.player_daily_micro_usd"
    },
    {
      "id": "character_game_day",
      "title": "Per character per game per day",
      "window": "day",
      "setting": "limits.game_daily_micro_usd"
    },
    {
      "id": "developer_day",
      "title": "Developer tests per developer per day",
      "window": "day",
      "setting": ""
    }
  ],
  "errors": [
    {
      "tag": "unavailable",
      "http_status": 503,
      "retryable": true,
      "fix": "Keep the offline fallback. Summer Router needs the Summer Player Host and a configured gateway."
    },
    {
      "tag": "not_signed_in",
      "http_status": 401,
      "retryable": false,
      "fix": "Ask the player to sign in to Summer, then try again."
    },
    {
      "tag": "not_on_summer_games",
      "http_status": 403,
      "retryable": false,
      "fix": "Summer Router works on games published on Summer Games during early preview. Publish the game on Summer Games; other platforms and storefronts are coming soon. Keep the offline fallback."
    },
    {
      "tag": "mic_denied",
      "http_status": 0,
      "retryable": false,
      "fix": "Fall back to text. Do not send the player to Settings."
    },
    {
      "tag": "character_not_found",
      "http_status": 404,
      "retryable": false,
      "fix": "Push the character with `summer router push`, then call it by its id."
    },
    {
      "tag": "tool_unhandled",
      "http_status": 0,
      "retryable": false,
      "fix": "Add a handler for this tool to the session's tools before the character calls it."
    },
    {
      "tag": "mic_needs_player_action",
      "http_status": 0,
      "retryable": false,
      "fix": "Call request_access() from the talk button's pressed signal, not from _ready(), a timer or a cutscene."
    },
    {
      "tag": "limit_reached",
      "http_status": 429,
      "retryable": true,
      "fix": "Wait until resets_at, or raise the cap in Studio or with `summer router limits set`."
    },
    {
      "tag": "credits_required",
      "http_status": 402,
      "retryable": false,
      "fix": "The game's owner adds credits in Studio.",
      "studio_url": "https://summerengine.com/studio/credits"
    },
    {
      "tag": "router_disabled",
      "http_status": 403,
      "retryable": false,
      "fix": "Turn on Summer Router for this game in Studio or with `summer router limits set`."
    },
    {
      "tag": "age_restricted",
      "http_status": 403,
      "retryable": false,
      "fix": "Keep the offline fallback for this player."
    },
    {
      "tag": "provider_unavailable",
      "http_status": 502,
      "retryable": true,
      "fix": "Retry later. The game keeps running."
    },
    {
      "tag": "moderated",
      "http_status": 422,
      "retryable": false,
      "fix": "The provider's safety filter blocked this turn. Rephrase, or show the fallback line."
    },
    {
      "tag": "invalid_input",
      "http_status": 400,
      "retryable": false,
      "fix": "Send inputs that match the kind's schema in the registry."
    },
    {
      "tag": "rate_limited",
      "http_status": 429,
      "retryable": true,
      "fix": "Slow down and retry after Retry-After seconds."
    }
  ]
}
